# Ambiente
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dropjoy.db
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Autenticação
# Em produção, use uma chave longa e aleatória e nunca faça commit do .env.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
DEMO_USER_EMAIL=joyce@demo.local
DEMO_USER_PASSWORD=dropjoy-demo

# Premissas de demonstração - NÃO são tarifas oficiais atuais da Shopee.
MARKETPLACE_PERCENT_FEE=0.20
MARKETPLACE_FIXED_FEE=4.00

# Dropify - preencher somente após homologação/credenciais reais.
DROPIFY_ENABLED=false
DROPIFY_BASE_URL=
DROPIFY_API_TOKEN=
DROPIFY_PRODUCTS_PATH=
DROPIFY_STOCK_PATH=
