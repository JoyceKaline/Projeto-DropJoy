# Ambiente
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dropjoy.db
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Autenticação
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
PASSWORD_RESET_MINUTES=30
EXPOSE_RESET_TOKENS_IN_DEV=true
DEMO_USER_EMAIL=joyce@demo.local
DEMO_USER_PASSWORD=dropjoy-demo

# Primeiro owner (produção: executar python -m app.cli bootstrap)
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# E-mail para recuperação de senha
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_BASE_URL=http://127.0.0.1:5500/?reset_token=

# DropJoy AI - opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Premissas demonstrativas - NÃO são tarifas oficiais atuais da Shopee.
MARKETPLACE_PERCENT_FEE=0.20
MARKETPLACE_FIXED_FEE=4.00

# Dropify
DROPIFY_ENABLED=false
DROPIFY_BASE_URL=
DROPIFY_API_TOKEN=
DROPIFY_PRODUCTS_PATH=
DROPIFY_STOCK_PATH=

# DSLite
DSLITE_ENABLED=false
DSLITE_BASE_URL=
DSLITE_API_TOKEN=
DSLITE_PRODUCTS_PATH=

# Shopee
SHOPEE_ENABLED=false
SHOPEE_BASE_URL=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
