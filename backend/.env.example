# Ambiente
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dropjoy.db
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Autenticação
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
PASSWORD_RESET_MINUTES=30
EXPOSE_RESET_TOKENS_IN_DEV=true
DEMO_USER_EMAIL=joyce@demo.local
DEMO_USER_PASSWORD=dropjoy-demo

# Premissas de demonstração - NÃO são tarifas oficiais atuais da Shopee.
MARKETPLACE_PERCENT_FEE=0.20
MARKETPLACE_FIXED_FEE=4.00

# Dropify
DROPIFY_ENABLED=false
DROPIFY_BASE_URL=
DROPIFY_API_TOKEN=
DROPIFY_PRODUCTS_PATH=
DROPIFY_STOCK_PATH=
